# Binance USDⓈ-M Perpetual Futures public endpoints (NO API keys required)
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com

# Persistent SQLite database path
DB_PATH=./data/scanner.db

# Scanner cadence & symbol coverage (SCAN_LIMIT=0 scans ALL Binance USDT perpetual contracts)
SCAN_LIMIT=0
SCAN_INTERVAL_SEC=60
KLINE_LIMIT=250

# Optional Telegram push notifications (configure via Replit Secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server bind (0.0.0.0 required for Replit / cloud preview)
HOST=0.0.0.0
PORT=8000
